{
  "name": "pedido-web-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start -p 10016",
    "lint": "next lint",
    "format": "dprint fmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit": "npm audit",
    "semgrep": "semgrep scan --config=auto --error src/",
    "check": "yarn lint && yarn test && yarn build"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-brands-svg-icons": "^6.6.0",
    "@fortawesome/free-regular-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.1",
    "@react-pdf/renderer": "^4.0.0",
    "apexcharts": "^4.1.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "lodash": "^4.17.21",
    "next": "14.2.6",
    "react": "^18",
    "react-apexcharts": "^1.6.0",
    "react-dom": "^18",
    "react-icons": "^5.3.0",
    "react-toastify": "^11.0.3",
    "sharp": "^0.33.5",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^15.1.2",
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/lodash": "^4.17.7",
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "7.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^7.0.3",
    "eslint": "8",
    "eslint-config-next": "14.2.6",
    "eslint-plugin-security": "^3",
    "postcss": "^8",
    "tailwindcss": "^3.4.10",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
